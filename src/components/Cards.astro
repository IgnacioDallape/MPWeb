---
// Tarjetas tipadas para tratamientos, lesiones y artículos.
import Card from './Card.astro';
import { CATEGORIES } from '../data/index.js';
import { certBadge, TREATMENT_CERT } from '../lib/components.js';
interface Props { kind: 'tratamientos' | 'lesiones' | 'blog'; items: any[]; dark?: boolean }
const { kind, items, dark = false } = Astro.props;
---
{items.map((it) =>
  kind === 'tratamientos' ? (
    <Card dark={dark} href={`/tratamientos/${it.slug}/`} title={it.name} text={it.cardText} icon={it.icon} badge={TREATMENT_CERT[it.slug] && certBadge(TREATMENT_CERT[it.slug], 72, 'mb-2')} tag={it.shortName} more="Conocer el tratamiento" />
  ) : kind === 'lesiones' ? (
    <Card dark={dark} href={`/lesiones/${it.slug}/`} title={it.name} text={it.cardText} icon={it.icon} tag={CATEGORIES[it.category]?.label} more="Ver tratamiento" />
  ) : (
    <Card dark={dark} href={`/blog/${it.slug}/`} title={it.h1} text={it.description} tag={it.category} more="Leer artículo" />
  )
)}
