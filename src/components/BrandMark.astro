---
// Monograma M/P de MP Studio sobre placa clara (public/img/logo/mp-mark.svg).
interface Props { class?: string }
const { class: cls = 'size-11' } = Astro.props;
---
<img src="/img/logo/mp-mark.svg" alt="" width="44" height="44" class:list={['block shrink-0 rounded-[10px] shadow-[0_6px_18px_-8px_rgba(0,0,0,.6)] ring-1 ring-white/20', cls]} decoding="async" />
