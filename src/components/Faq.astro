---
import { markdown } from '../lib/md.js';
import { tokens } from '../lib/site.js';
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
<div class="faq grid gap-3">
  {faqs.map((f, i) => (
    <details open={i === 0} data-reveal>
      <summary><h3>{tokens(f.q)}</h3></summary>
      <div class="answer" set:html={markdown(tokens(f.a)).html} />
    </details>
  ))}
</div>
