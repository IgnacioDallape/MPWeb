---
import Icon from './Icon.astro';
import Render3D from './Render3D.astro';
interface Props { href: string; title: string; text: string; icon?: string; badge?: string; tag?: string; more?: string; dark?: boolean; render?: string; renderAlt?: string }
const { href, title, text, icon, badge, tag, more = 'Ver más', dark = false, render, renderAlt = '' } = Astro.props;
---
<article class:list={['spotlight group', dark ? 'card border-white/10 bg-white/[0.03] text-white hover:border-ice-300/30' : 'card card-hover']} data-reveal data-spotlight>
  {render && (
    <div class:list={['relative -mx-3 -mt-3 mb-1 grid aspect-[16/10] place-items-center overflow-hidden rounded-2xl', dark ? 'bg-gradient-to-b from-white/[0.06] to-transparent' : 'bg-gradient-to-b from-navy-50 to-white']}>
      <Render3D name={render} alt={renderAlt} class="h-full w-full p-3 transition-transform duration-700 ease-out-expo group-hover:scale-[1.06] group-hover:-rotate-1" />
      {badge && <span class="absolute top-2 right-2"><Fragment set:html={badge} /></span>}
    </div>
  )}
  {render ? null : badge ? <Fragment set:html={badge} /> : icon && (
    <span class:list={['mb-2 grid size-12 place-items-center rounded-2xl', dark ? 'bg-white/10 text-ice-300' : 'bg-navy-50 text-navy-700']}><Icon name={icon} /></span>
  )}
  {tag && <span class="tag">{tag}</span>}
  <h3 class:list={['text-[1.25rem] leading-tight font-semibold', dark ? 'text-white' : 'text-ink']}><a href={href} class="card-link-cover text-inherit no-underline">{title}</a></h3>
  <p class:list={['m-0 text-[0.96rem] leading-relaxed', dark ? 'text-white/75' : 'text-zinc-600']}>{text}</p>
  <span aria-hidden="true" class:list={['mt-auto inline-flex items-center gap-2 pt-3 text-[0.88rem] font-bold', dark ? 'text-ice-300' : 'text-navy-600']}>{more}<Icon name="arrow" size={16} class="transition-transform duration-300 group-hover:translate-x-1" /></span>
</article>
