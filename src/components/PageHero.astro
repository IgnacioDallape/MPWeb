---
import Breadcrumbs from './Breadcrumbs.astro';
import { inline } from '../lib/md.js';
import { tokens } from '../lib/site.js';
import Render3D from './Render3D.astro';
import { picture } from '../lib/components.js';
interface Props { crumbs: { name: string; path: string }[]; eyebrow?: string; h1: string; lead?: string; facts?: { label: string; value: string }[]; render?: string; renderAlt?: string; photo?: string; photoAlt?: string }
const { crumbs, eyebrow, h1, lead, facts, render, renderAlt = '', photo, photoAlt = '' } = Astro.props;
// Foto real (src/images → public/img): tiene prioridad sobre el render 3D.
const photoHtml = photo ? picture(photo, photoAlt, { sizes: '(min-width: 1024px) 420px, 100vw', priority: true }) : '';
const side = photoHtml || render;
---
<section class="on-dark noise relative overflow-hidden bg-navy-950 pt-32 pb-12 text-white md:pt-44 md:pb-20">
  <div class="bg-grid bg-grid-fade absolute inset-0" aria-hidden="true"></div>
  <div class="glow -top-40 right-[-10%] size-[640px] opacity-60" aria-hidden="true"></div>
  <div class="glow bottom-[-60%] left-[-10%] size-[520px] opacity-30" aria-hidden="true"></div>
  {photoHtml && (
    <div class="absolute top-36 right-[5%] hidden w-[32%] max-w-[440px] overflow-hidden rounded-[2rem] shadow-[0_40px_80px_-30px_rgba(0,0,0,.7)] ring-1 ring-white/15 lg:block">
      <div class="aspect-[4/5]" set:html={photoHtml} />
    </div>
  )}
  {!photoHtml && render && (
    <div class="pointer-events-none absolute top-32 right-0 hidden w-[42%] max-w-[700px] lg:block xl:right-[3%]" aria-hidden="true">
      <div class="glow inset-[10%] opacity-70"></div>
      <Render3D name={render} alt={renderAlt} size="lg" eager width={900} height={560} class="render-float relative w-full drop-shadow-[0_40px_60px_rgba(0,0,0,.45)]" />
    </div>
  )}
  <div class="relative mx-auto max-w-[1240px] px-5 sm:px-8">
    <Breadcrumbs items={crumbs} />
    {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
    <h1 class:list={['max-w-[18em] text-[clamp(2.2rem,5.6vw,4.2rem)] leading-[1.02] font-semibold', side && 'lg:max-w-[54%]']} data-hero-title>{tokens(h1)}</h1>
    {lead && <p class="mt-6 max-w-3xl lg:max-w-[52%] text-[clamp(1.05rem,1.9vw,1.25rem)] leading-relaxed text-white/70" set:html={inline(tokens(lead))} />}
    <slot />
    {photoHtml && <div class="mt-10 aspect-[4/3] overflow-hidden rounded-3xl ring-1 ring-white/15 lg:hidden" set:html={photoHtml.replace('fetchpriority="high"', 'loading="lazy"')} />}
    {facts && (
      <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 lg:grid-cols-4" data-reveal>
        {facts.map((f) => (
          <div class="bg-navy-950/80 p-5">
            <dt class="font-display text-[0.68rem] font-semibold tracking-[0.18em] text-ice-300/70 uppercase">{f.label}</dt>
            <dd class="mt-2 text-[0.95rem] leading-snug font-semibold text-white">{tokens(f.value)}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
