---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Cards from '../components/Cards.astro';
import Faq from '../components/Faq.astro';
import CertRow from '../components/CertRow.astro';
import CertStrip from '../components/CertStrip.astro';
import { ultrasoundHero, ultrasoundLive } from '../lib/visuals.js';
import { picture } from '../lib/components.js';
import { config, known, waLink, tokens } from '../lib/site.js';
import { treatments, lesions, CATEGORIES, homePosts } from '../data/index.js';
import { HOME_FAQS } from '../data/faqs.js';
import { CATEGORY_RENDER } from '../data/renders.js';
import * as S from '../lib/schema.js';

const p = config.professional;
const b = config.business;
const wa = 'Hola, quería solicitar una evaluación de fisioterapia invasiva ecoguiada.';
const groups = Object.entries(CATEGORIES).map(([key, c]) => ({ key, ...c, items: lesions.filter((l) => l.category === key) }));
const ticker = ['Ecografía musculoesquelética', 'Electrólisis percutánea · EPI', 'Neuromodulación percutánea · NMP-e', 'Microelectrólisis · MEP', 'Punción seca ecoguiada', 'Ejercicio terapéutico', 'Readaptación deportiva', 'Tendinopatías', 'Lesiones musculares'];
const benefits = [
  ['target', 'Mayor precisión', 'La ecografía permite visualizar las estructuras en tiempo real y guiar la intervención hacia la zona de interés.'],
  ['needle', 'Intervención específica', 'Permite actuar directamente sobre determinadas estructuras musculares, tendinosas o nerviosas, y no sobre el tejido de alrededor.'],
  ['pulse', 'Abordaje del dolor persistente', 'Algunos tratamientos pueden incorporarse al abordaje de cuadros musculoesqueléticos que se mantienen en el tiempo.'],
  ['layers', 'Lesiones complejas', 'Puede utilizarse dentro del plan de rehabilitación de lesiones crónicas o recurrentes que no evolucionan como se espera.'],
  ['activity', 'Integración con rehabilitación', 'No es una intervención aislada: se complementa con ejercicio terapéutico, readaptación y progresión de cargas.'],
];
const steps = [
  ['evaluation', 'Evaluación y anamnesis', 'Historia de la lesión, actividad, tratamientos previos y pruebas físicas de movilidad, fuerza y carga.'],
  ['probe', 'Ecografía musculoesquelética', 'Se observa la estructura afectada, su organización y su comportamiento en movimiento.'],
  ['needle', 'Intervención ecoguiada', 'Si está indicado, se aplica el tratamiento más adecuado con guía ecográfica en tiempo real.'],
  ['progress', 'Readaptación y ejercicio', 'Plan de cargas progresivas para consolidar la recuperación y volver a tu actividad.'],
];
const xpSteps = [
  { tag: 'Evaluación', title: 'Entender qué estructura está alterada', text: 'En una tendinopatía, las fibras del tendón pierden su organización y el tejido tolera peor la carga. Todo empieza con la historia clínica y la exploración física.' },
  { tag: 'Ecografía', title: 'Ver el tejido en tiempo real', text: 'La sonda ecográfica recorre la zona y muestra el grosor, la organización de las fibras y el área alterada, en reposo y en movimiento.', link: ['/blog/ecografia-en-fisioterapia/', '¿Para qué sirve la ecografía?'] },
  { tag: 'Intervención', title: 'La aguja llega al punto exacto', text: 'Con guía ecográfica, una aguja ultrafina se dirige a la estructura objetivo. Según el caso: EPI, MEP, neuromodulación o punción seca.', link: ['/tratamientos/', 'Conocer los tratamientos'] },
  { tag: 'Readaptación', title: 'Un tejido que vuelve a tolerar carga', text: 'El ejercicio terapéutico y la progresión de cargas acompañan la recuperación para que vuelvas a entrenar, trabajar o competir.', link: ['/sobre-mi/', 'Ver la metodología'] },
];
const schema = [
  S.webPage({ path: '/', title: 'Fisioterapia Invasiva Ecoguiada', description: 'Kinesiología especializada en fisioterapia invasiva ecoguiada.', updated: config.launchDate, extra: { about: { '@id': S.ids.ORG_ID() }, mainEntity: { '@id': S.ids.ORG_ID() } } }),
  S.faqPage('/', HOME_FAQS),
];
---
<Base
  title="Fisioterapia Invasiva Ecoguiada en {{CIUDAD}} | {{NOMBRE}}"
  description="Fisioterapia invasiva ecoguiada en {{CIUDAD}}: EPI, neuromodulación percutánea, MEP y punción seca para tendinopatías y lesiones deportivas."
  schema={schema}
  waMessage={wa}
>
  <!-- ============ HERO + EXPERIENCIA 3D ============ -->
  <div id="xp" class="on-dark relative bg-navy-950 text-white">
    <!-- Lienzo 3D del hero -->
    <div class="pointer-events-none sticky top-0 h-[100svh] overflow-hidden" aria-hidden="true">
      <div data-xp-deco class="bg-grid bg-grid-fade absolute inset-0"></div>
      <div data-xp-deco class="glow -top-48 right-[-15%] size-[760px] opacity-60"></div>
      <div data-xp-deco class="glow bottom-[-30%] left-[-20%] size-[620px] opacity-35"></div>
      <picture data-xp-poster class="absolute inset-0 transition-opacity duration-1000">
        <source type="image/webp" srcset="/img/hero-3d-mobile.webp" media="(max-width: 1023px)" />
        <source type="image/webp" srcset="/img/hero-3d.webp" />
        <img src="/img/hero-3d.jpg" alt="" width="1600" height="900" fetchpriority="low" decoding="async" class="h-full w-full object-cover opacity-90" />
      </picture>
      <canvas id="xp-canvas" class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"></canvas>
      <div data-xp-overlay class="absolute inset-0 bg-gradient-to-b from-navy-950/40 via-navy-950/75 to-navy-950 lg:bg-gradient-to-r lg:from-navy-950/95 lg:via-navy-950/40 lg:to-transparent"></div>
      <div data-xp-overlay class="noise absolute inset-0"></div>

    </div>

    <div class="relative -mt-[100svh]">
      <section class="relative mx-auto flex min-h-[100svh] max-w-[1320px] items-center px-5 pt-28 pb-20 sm:px-8" aria-labelledby="h1">
        <div class="max-w-2xl">
          <p class="mb-7 inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 py-1.5 pr-4 pl-2 text-[0.8rem] font-medium text-white/75">
            <span class="relative grid size-5 place-items-center"><span class="pulse-dot relative size-2 rounded-full bg-ice-400"></span></span>
            Kinesiología · Ecografía · Rehabilitación deportiva
          </p>
          <h1 id="h1" class="text-[clamp(2.7rem,7.4vw,5.6rem)] leading-[0.98] font-semibold tracking-[-0.045em]" data-hero-title>
            Fisioterapia Invasiva <span class="text-gradient">Ecoguiada</span>
            <span class="mt-2 block text-[0.52em] font-medium tracking-[-0.02em] text-white/70">{tokens('en {{CIUDAD}}')}</span>
          </h1>
          <p class="mt-7 max-w-xl text-[clamp(1.08rem,1.9vw,1.28rem)] leading-relaxed text-white/75">
            Tratamientos de alta precisión guiados por ecografía para lesiones musculares, tendinosas y del sistema nervioso periférico, integrados con rehabilitación y ejercicio terapéutico.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={waLink(wa)} class="btn btn-glow btn-shine" data-magnetic><Icon name="whatsapp" size={20} />Solicitar evaluación</a>
            <a href="/tratamientos/" class="btn btn-outline-dark">Conocer tratamientos<Icon name="arrow" size={18} /></a>
          </div>
          <p class="mt-10 flex items-start gap-3 text-[0.88rem] text-white/70">
            <Icon name="shield" size={20} class="mt-0.5 text-ice-400" />
            <span><strong class="text-white/85">{b.name}</strong> · Kinesiología y fisioterapia invasiva ecoguiada<br />Consultorio en {b.city} · Atención en todo {b.province}</span>
          </p>
        </div>
        <!-- Vista ecográfica 2D (HUD) -->
        <div class="glass absolute right-8 bottom-24 hidden w-[330px] rounded-2xl bg-navy-950/60 p-2 2xl:block" data-ultrasound>
          <div class="relative overflow-hidden rounded-xl [aspect-ratio:560/470]"><Fragment set:html={ultrasoundHero({ live: true })} /><Fragment set:html={ultrasoundLive()} /></div>
          <p class="flex items-center gap-2 px-2 pt-2 pb-1 text-[0.72rem] font-semibold tracking-[0.14em] text-ice-300/80 uppercase"><span class="pulse-dot relative size-1.5 rounded-full bg-ice-400"></span>Vista ecográfica en tiempo real</p>
        </div>
        <a href="#que-es" class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.72rem] tracking-[0.2em] text-white/40 uppercase no-underline md:flex">Descubrí más<span class="block h-10 w-px animate-pulse bg-gradient-to-b from-ice-300 to-transparent"></span></a>
      </section>

    </div>
  </div>

  <section class="on-dark relative overflow-hidden bg-navy-950 text-white" aria-label="Tratamientos y diferenciales">
    <!-- Marquee de tratamientos -->
    <div class="marquee relative border-y border-white/10 bg-white/[0.02] py-5" aria-hidden="true">
      <div class="marquee-track flex w-max gap-12 font-display text-[1.05rem] font-medium whitespace-nowrap text-white/45">
        {[...ticker, ...ticker].map((t) => <span class="flex items-center gap-12">{t}<span class="text-ice-400/60">✦</span></span>)}
      </div>
    </div>

    <!-- Diferenciales -->
    <div class="relative mx-auto max-w-[1320px] px-5 py-14 sm:px-8">
      <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 lg:grid-cols-4">
        {[
          ['probe', 'Ecografía en tiempo real', 'Se ve la estructura y la aguja durante toda la intervención.'],
          ['needle', 'Mínimamente invasivo', 'Agujas ultrafinas, material estéril de un solo uso.'],
          ['evaluation', 'Evaluación individual', 'Anamnesis, exploración y ecografía antes de decidir.'],
          ['activity', 'Rehabilitación y ejercicio', 'El tratamiento se integra en un plan de cargas progresivas.'],
        ].map(([ic, t, d]) => (
          <li class="flex flex-col gap-3 bg-navy-950/90 p-6 md:p-8" data-reveal>
            <Icon name={ic} size={28} class="text-ice-300" />
            <strong class="font-display text-[1.02rem] leading-snug font-semibold text-white">{t}</strong>
            <span class="text-[0.88rem] leading-relaxed text-white/65">{d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ DESCRIPCIÓN ============ -->
  <section class="relative bg-white py-24 md:py-32" aria-labelledby="que-es">
    <div class="bg-dots-light absolute inset-x-0 top-0 h-64 [mask-image:linear-gradient(#000,transparent)]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-[1240px] items-center gap-14 px-5 sm:px-8 lg:grid-cols-2 lg:gap-20">
      <div>
        <div data-reveal>
          <p class="eyebrow mb-4">Descripción</p>
          <h2 id="que-es" class="text-[clamp(2rem,4.4vw,3.3rem)] leading-[1.04] font-semibold text-navy-950">¿Qué es la Fisioterapia Invasiva <span class="text-gradient-navy">Ecoguiada</span>?</h2>
        </div>
        <div class="mt-7 space-y-5 text-[1.08rem] text-zinc-600" data-reveal>
          <p>La <strong class="text-navy-950">fisioterapia invasiva ecoguiada</strong> engloba tratamientos que utilizan agujas ultrafinas para actuar directamente sobre la estructura afectada, siempre guiados por ecografía. Permite tratar de forma precisa lesiones tendinosas, musculares, ligamentarias y estructuras relacionadas con el sistema nervioso periférico.</p>
          <p>Tras una evaluación y anamnesis completa se identifica la estructura implicada y se determina el tratamiento más adecuado. Estas intervenciones forman parte de un abordaje integral que se complementa con readaptación, ejercicio terapéutico y cargas progresivas.</p>
        </div>
        <a href="/fisioterapia-invasiva-ecoguiada/" class="btn btn-outline mt-8" data-reveal>Guía completa de fisioterapia invasiva ecoguiada<Icon name="arrow" size={18} /></a>
        <div data-reveal><CertRow cert="ecografia" /></div>
      </div>
      <figure class="relative m-0" data-reveal>
        <div id="slab" class="relative aspect-[4/3] cursor-grab overflow-hidden rounded-[2rem] bg-gradient-to-br from-navy-50 via-white to-zinc-100 ring-1 ring-navy-700/10 active:cursor-grabbing">
          <div class="bg-dots-light absolute inset-0 opacity-70" aria-hidden="true"></div>
          <img data-slab-poster src="/img/3d/slab.webp" alt="Ilustración 3D de un corte de tejido: piel, tejido subcutáneo, músculo y tendón, con la sonda ecográfica y la aguja llegando a la zona a tratar" width="900" height="675" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-contain p-4 transition-opacity duration-700" />
          <canvas id="slab-canvas" class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700" aria-hidden="true"></canvas>
          <ul class="pointer-events-none absolute top-4 left-4 grid gap-1.5 text-[0.7rem] font-semibold tracking-[0.12em] uppercase" aria-hidden="true">
            <li class="flex items-center gap-2 text-[#b08d7c]"><span class="size-2 rounded-full bg-[#ead1c4]"></span>Piel</li>
            <li class="flex items-center gap-2 text-[#a8925c]"><span class="size-2 rounded-full bg-[#f2dfb5]"></span>Tejido subcutáneo</li>
            <li class="flex items-center gap-2 text-[#b25e60]"><span class="size-2 rounded-full bg-[#d4797b]"></span>Músculo</li>
            <li class="flex items-center gap-2 text-navy-500"><span class="size-2 rounded-full bg-[#b9cbe8]"></span>Tendón</li>
          </ul>
          <span class="pointer-events-none absolute right-4 bottom-4 rounded-full bg-white/80 px-3 py-1 text-[0.72rem] font-semibold text-navy-600 ring-1 ring-navy-700/10" aria-hidden="true">Arrastrá para girar</span>
        </div>
        <figcaption class="px-2 pt-3 text-[0.82rem] text-zinc-500">La sonda ecográfica permite seguir el recorrido de la aguja hasta la estructura objetivo.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ BENEFICIOS ============ -->
  <section class="on-dark noise relative overflow-hidden bg-navy-950 py-24 text-white md:py-32" aria-labelledby="por-que">
    <div class="bg-grid bg-grid-fade absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div class="glow top-1/3 left-1/2 size-[700px] -translate-x-1/2 opacity-40" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1240px] px-5 sm:px-8">
      <SectionHead id="por-que" eyebrow="Por qué ecoguiada" title='Beneficios de la Fisioterapia Invasiva <span class="text-gradient">Ecoguiada</span>' lead="La ecografía convierte un tratamiento basado en la palpación en una intervención visible, específica y controlada." center />
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {benefits.map(([ic, t, d]) => (
          <div class="spotlight card border-white/10 bg-white/[0.03] hover:border-ice-300/30" data-reveal data-spotlight>
            <span class="mb-2 grid size-12 place-items-center rounded-2xl bg-white/10 text-ice-300"><Icon name={ic} /></span>
            <h3 class="text-[1.2rem] font-semibold text-white">{t}</h3>
            <p class="m-0 text-[0.96rem] leading-relaxed text-white/75">{d}</p>
          </div>
        ))}
        <div class="card overflow-hidden border-0 bg-gradient-to-br from-ice-500 to-navy-600 text-white" data-reveal>
          <div class="glow -right-20 -bottom-24 size-72 opacity-60" aria-hidden="true"></div>
          <span class="relative mb-2 grid size-12 place-items-center rounded-2xl bg-white/20"><Icon name="shield" /></span>
          <h3 class="relative text-[1.2rem] font-semibold">Seguridad</h3>
          <p class="relative m-0 text-[0.96rem] leading-relaxed text-white/85">Ver vasos, nervios y otras estructuras sensibles durante la intervención permite evitarlos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PATOLOGÍAS ============ -->
  <section class="relative bg-zinc-50 py-24 md:py-32" aria-labelledby="lesiones">
    <div class="bg-dots-light absolute inset-0 [mask-image:radial-gradient(ellipse_at_top,#000,transparent_70%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1240px] px-5 sm:px-8">
      <SectionHead id="lesiones" eyebrow="Patologías" title='¿Qué lesiones y patologías pueden <span class="text-gradient-navy">abordarse</span>?' lead="Lesiones deportivas y del día a día en las que la fisioterapia invasiva ecoguiada puede formar parte del plan." />
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {groups.map((g) => (
          <div class="card card-hover spotlight group p-6" data-reveal data-spotlight>
            <div class="-mx-2 -mt-2 mb-2 grid aspect-[16/9] place-items-center overflow-hidden rounded-2xl bg-gradient-to-b from-navy-50 to-white"><img src={`/img/3d/${CATEGORY_RENDER[g.key]}-sm.webp`} alt={`Ilustración 3D: ${g.label}`} width="480" height="270" loading="lazy" decoding="async" class="h-full w-full object-contain p-3 transition-transform duration-700 ease-out-expo group-hover:scale-[1.06]" /></div>
            <h3 class="mb-1 flex items-center gap-3 text-[1.1rem] font-semibold text-navy-950"><span class="grid size-10 place-items-center rounded-xl bg-navy-950 text-ice-300"><Icon name={g.icon} size={20} /></span>{g.label}</h3>
            <ul class="divide-y divide-zinc-200">
              {g.items.map((l) => (
                <li><a href={`/lesiones/${l.slug}/`} class="group/item relative z-10 flex items-center gap-3 py-2.5 text-[0.96rem] font-medium text-zinc-700 no-underline transition hover:text-navy-900"><span class="grid size-12 flex-none place-items-center rounded-xl bg-gradient-to-b from-navy-50 to-white ring-1 ring-navy-700/5"><img src={`/img/3d/${l.slug}-sm.webp`} alt="" width="48" height="48" loading="lazy" decoding="async" class="size-11 object-contain transition-transform duration-500 group-hover/item:scale-110" /></span><span class="flex-1">{l.name}</span><Icon name="arrow" size={16} class="text-zinc-300 transition group-hover/item:translate-x-1 group-hover/item:text-navy-600" /></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a href="/lesiones/" class="mt-10 inline-flex items-center gap-2 font-semibold text-navy-600 no-underline hover:text-navy-950" data-reveal>Ver todas las patologías<Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <!-- ============ TRATAMIENTOS ============ -->
  <section class="relative bg-white py-24 md:py-32" aria-labelledby="tratamientos">
    <div class="relative mx-auto max-w-[1240px] px-5 sm:px-8">
      <SectionHead id="tratamientos" eyebrow="Tratamientos" title='Tratamientos de fisioterapia invasiva <span class="text-gradient-navy">guiados por ecografía</span>' lead="Cada tratamiento tiene un objetivo distinto. La elección depende del tejido afectado, de la fase de la lesión y de tu actividad." />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><Cards kind="tratamientos" items={treatments} /></div>
      <a href="/tratamientos/" class="mt-10 inline-flex items-center gap-2 font-semibold text-navy-600 no-underline hover:text-navy-950" data-reveal>Comparar todos los tratamientos<Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <!-- ============ METODOLOGÍA Y PASOS ============ -->
  <section aria-labelledby="proceso">
    <div id="metodo" class="on-dark relative bg-navy-950 text-white">
      <div class="pointer-events-none sticky top-0 h-[100svh] overflow-hidden" aria-hidden="true">
        <div class="bg-grid bg-grid-fade absolute inset-0"></div>
        <div class="glow -top-40 right-[-10%] size-[700px] opacity-50"></div>
        <picture data-metodo-poster class="absolute inset-0 transition-opacity duration-1000">
          <source type="image/webp" srcset="/img/hero-3d-mobile.webp" media="(max-width: 1023px)" />
          <source type="image/webp" srcset="/img/hero-3d.webp" />
          <img src="/img/hero-3d.jpg" alt="" width="1600" height="900" loading="lazy" decoding="async" class="h-full w-full object-cover opacity-80" />
        </picture>
        <canvas id="metodo-canvas" class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"></canvas>
        <div class="absolute inset-0 bg-gradient-to-b from-navy-950/40 via-navy-950/70 to-navy-950 lg:bg-gradient-to-r lg:from-navy-950/90 lg:via-navy-950/30 lg:to-transparent"></div>
        <ol class="absolute top-1/2 right-6 z-10 hidden -translate-y-1/2 flex-col gap-3 lg:flex">
          {xpSteps.map(() => <li data-metodo-dot class="size-2 rounded-full bg-white/20 transition-all duration-500 data-[active]:h-6 data-[active]:bg-ice-300"></li>)}
        </ol>
      </div>
      <div class="relative -mt-[100svh]">
        <div class="mx-auto flex min-h-[70svh] max-w-[1320px] items-center px-5 pt-24 sm:px-8">
          <SectionHead id="proceso" eyebrow="Metodología y pasos" title='Primero se evalúa. <span class="text-gradient">Después se decide.</span>' lead="Ningún tratamiento se aplica sin entender antes qué le pasa a tu tejido y qué necesitás recuperar. Así es el recorrido, paso a paso." />
        </div>
        <ol>
          {xpSteps.map((st, i) => (
            <li data-metodo-step class="mx-auto flex min-h-[100svh] max-w-[1320px] items-end px-5 pb-24 sm:px-8 lg:items-center lg:pb-0">
              <article class="glass max-w-md rounded-3xl bg-navy-950/65 p-7 md:p-9" data-reveal>
                <p class="font-display text-[0.75rem] font-semibold tracking-[0.22em] text-ice-300">PASO {String(i + 1).padStart(2, '0')} · {st.tag}</p>
                <h3 class="mt-3 text-[clamp(1.6rem,3vw,2.3rem)] leading-[1.05] font-semibold">{st.title}</h3>
                <p class="mt-4 text-white/75">{st.text}</p>
                {st.link && <a href={st.link[0]} class="mt-5 inline-flex items-center gap-2 text-[0.9rem] font-semibold text-ice-300 no-underline hover:text-white">{st.link[1]}<Icon name="arrow" size={16} /></a>}
              </article>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-white py-24 md:py-32" aria-labelledby="profesional">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
      <div class="mt-24 grid items-center gap-10 overflow-hidden rounded-[2rem] border border-zinc-200 bg-zinc-50 p-6 md:p-10 lg:grid-cols-[320px_1fr] lg:gap-14" data-reveal>
        <div class="grid aspect-[4/5] place-items-center overflow-hidden rounded-3xl bg-gradient-to-br from-navy-900 to-navy-700 p-6 text-center text-[0.85rem] text-white/70">
          <Fragment set:html={picture('profesional', `${b.name}: evaluación con ecografía musculoesquelética`, { sizes: '(min-width: 1024px) 320px, 100vw' }) || '<img src="/img/3d/probe.webp" alt="Ilustración 3D de una sonda ecográfica" width="600" height="700" loading="lazy" decoding="async" class="render-float h-full w-full object-contain p-6" />'} />
        </div>
        <div>
          <p class="eyebrow mb-3">Metodología · Profesional</p>
          <h2 id="profesional" class="text-[clamp(1.8rem,3.4vw,2.6rem)] font-semibold text-navy-950">El equipo de {b.name}</h2>
          <p class="mt-3 text-[1.1rem] text-zinc-600">Kinesiología con formación específica en ecografía musculoesquelética y fisioterapia invasiva.</p>
          <dl class="mt-6 grid gap-x-8 sm:grid-cols-2">
            {[['Formación', p.education.join(' · ')], ['Especialización', p.specializations.join(' · ')], ['Experiencia', p.experience]].map(([k, v]) => (
              <div class="border-b border-zinc-200 py-3"><dt class="text-[0.78rem] font-semibold tracking-wide text-zinc-400 uppercase">{k}</dt><dd class="mt-1 font-semibold text-navy-950">{v}</dd></div>
            ))}
          </dl>
          <p class="eyebrow mt-8 mb-4">Certificaciones</p>
          <CertStrip />
          <a href="/sobre-mi/" class="btn btn-outline mt-8">Conocer trayectoria y formación<Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PREGUNTAS FRECUENTES Y DATOS ============ -->
  <section class="bg-zinc-50 py-24 md:py-32" aria-labelledby="faq-home">
    <div class="mx-auto grid max-w-[1240px] gap-12 px-5 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHead id="faq-home" eyebrow="Preguntas frecuentes y datos" title="Lo que más se consulta antes de empezar" lead="Respuestas claras sobre cómo es el tratamiento, qué se siente y qué esperar." />
        <a href="/preguntas-frecuentes/" class="btn btn-outline -mt-4">Ver todas las preguntas<Icon name="arrow" size={18} /></a>
        <h3 class="mt-12 mb-4 font-display text-[0.8rem] font-semibold tracking-[0.18em] text-zinc-400 uppercase">Para profundizar</h3>
        <ul class="grid gap-2">
          {homePosts.map((post) => (
            <li><a href={`/blog/${post.slug}/`} class="group flex items-start gap-3 rounded-xl p-2 text-[0.96rem] font-semibold text-navy-800 no-underline transition hover:bg-white"><Icon name="book" size={18} class="mt-1 text-navy-500" /><span>{post.h1}</span></a></li>
          ))}
        </ul>
      </div>
      <Faq faqs={HOME_FAQS} />
    </div>

    <div class="mx-auto mt-20 max-w-[1240px] px-5 sm:px-8">
      <div class="on-dark noise relative overflow-hidden rounded-[2rem] bg-navy-950 p-8 text-white md:p-14" data-reveal>
        <div class="bg-grid bg-grid-fade absolute inset-0" aria-hidden="true"></div>
        <div class="glow -top-40 -right-20 size-[520px] opacity-60" aria-hidden="true"></div>
        <div class="relative grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
          <div>
            <p class="eyebrow mb-4">{tokens('Turnos en {{CIUDAD}}')}</p>
            <h2 id="contacto-home" class="text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.03] font-semibold"><span class="text-gradient">Solicitá tu evaluación</span></h2>
            <p class="mt-4 max-w-lg text-white/65">Contanos brevemente qué te pasa y coordinamos una primera consulta de evaluación clínica y ecográfica.</p>
            <p class="mt-3 max-w-lg text-[0.92rem] text-white/65">Consultorio en {b.city}. Atendemos pacientes de todo Mendoza: {b.areaServed.filter((a) => a !== b.city).join(', ')}.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={waLink(wa)} class="btn btn-glow btn-shine" data-magnetic><Icon name="whatsapp" size={20} />Hablar por WhatsApp</a>
              <a href="/contacto/" class="btn btn-outline-dark">Ver dirección y horarios<Icon name="arrow" size={18} /></a>
            </div>
          </div>
          <address class="glass grid gap-5 rounded-3xl p-6 not-italic">
            <span class="flex gap-4"><Icon name="pin" class="mt-0.5 text-ice-300" /><span><strong class="block text-white">{b.name}</strong><span class="text-white/75">{b.address}, {b.city}, {b.province}</span></span></span>
            <span class="flex gap-4"><Icon name="whatsapp" class="mt-0.5 text-ice-300" /><span class="text-white/80">{config.contact.phoneDisplay}</span></span>
            <span class="flex gap-4"><Icon name="clock" class="mt-0.5 text-ice-300" /><span class="text-white/80">{config.hoursText}</span></span>
          </address>
        </div>
      </div>
    </div>
  </section>
  <script>
    import '../scripts/xp.js';
    import '../scripts/slab.js';
  </script>
</Base>
