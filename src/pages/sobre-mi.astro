---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CertStrip from '../components/CertStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { picture } from '../lib/components.js';
import { config, waLink, known } from '../lib/site.js';
import * as S from '../lib/schema.js';

const path = '/sobre-mi/';
const p = config.professional;
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Metodología', path }];
const steps = [
  ['evaluation', 'Evaluación y anamnesis', 'Entrevista sobre la lesión, la actividad y los objetivos; pruebas de movilidad, fuerza y tolerancia a la carga.'],
  ['probe', 'Ecografía musculoesquelética', 'Se observa la estructura implicada, su organización y su comportamiento en movimiento.'],
  ['needle', 'Intervención ecoguiada (si está indicada)', 'Se elige el tratamiento según el tejido y la fase de la lesión, siempre con guía ecográfica en tiempo real.'],
  ['progress', 'Readaptación y seguimiento', 'Ejercicio terapéutico, progresión de cargas y reevaluaciones para volver a tu actividad.'],
];
const areas = [
  ['/fisioterapia-invasiva-ecoguiada/', 'Fisioterapia invasiva ecoguiada'],
  ['/tratamientos/epi-electrolisis-percutanea/', 'Electrólisis percutánea (EPI)'],
  ['/tratamientos/microelectrolisis-percutanea-mep/', 'Microelectrólisis percutánea (MEP)'],
  ['/tratamientos/neuromodulacion-percutanea-ecoguiada/', 'Neuromodulación percutánea ecoguiada'],
  ['/tratamientos/puncion-seca-ecoguiada/', 'Punción seca ecoguiada'],
  ['/lesiones/', 'Tendinopatías y lesiones deportivas'],
];
const schema = [
  S.breadcrumbs(crumbs),
  S.webPage({ path, type: 'AboutPage', title: 'Metodología', description: 'Forma de trabajo: evaluación, ecografía, tratamiento y readaptación.', updated: config.launchDate, extra: { about: { '@id': S.ids.ORG_ID() } } }),
];
---
<Base
  title="Metodología: evaluación con ecografía | {{NOMBRE}}"
  description="Cómo trabaja {{NOMBRE}}: evaluación clínica y ecográfica, kinesiología, fisioterapia invasiva ecoguiada y readaptación, en {{LOCALIDAD}}, {{CIUDAD}}."
  schema={schema}
>
  <PageHero crumbs={crumbs} eyebrow="Metodología" render="probe" renderAlt="Ilustración 3D de una sonda ecográfica" h1={`${config.business.name}: fisioterapia invasiva ecoguiada con método`} lead={`Kinesiología especializada en tratamientos ecoguiados. Consultorio en {{LOCALIDAD}}, con atención para todo {{PROVINCIA}}.`}>
    <div class="mt-9"><a href={waLink()} class="btn btn-glow btn-shine" data-magnetic><Icon name="whatsapp" size={20} />Solicitar una evaluación</a></div>
  </PageHero>

  <section class="bg-white py-14 md:py-28" aria-labelledby="forma">
    <div class="mx-auto grid max-w-[1240px] items-center gap-12 px-5 sm:px-8 lg:grid-cols-[360px_1fr] lg:gap-16">
      <div class="grid aspect-[4/5] place-items-center overflow-hidden rounded-[2rem] bg-gradient-to-br from-navy-900 to-navy-700 p-6 text-center text-[0.85rem] text-white/70" data-reveal>
        <Fragment set:html={picture('profesional', `${config.business.name}: evaluación ecográfica`, { sizes: '(min-width: 1024px) 360px, 100vw' }) || '<img src="/img/3d/probe.webp" alt="Ilustración 3D de una sonda de ecografía musculoesquelética" width="480" height="300" loading="lazy" decoding="async" class="w-full object-contain" />'} />
      </div>
      <div>
        <SectionHead id="forma" eyebrow="Nuestra forma de trabajar" title='Tecnología al servicio de <span class="text-gradient-navy">una buena evaluación</span>' />
        <div class="-mt-4 space-y-5 text-[1.08rem] text-zinc-600" data-reveal>
          <p>Nos especializamos en el tratamiento de lesiones musculoesqueléticas combinando <strong class="text-ink">kinesiología, ecografía musculoesquelética, fisioterapia invasiva y ejercicio terapéutico</strong>. La ecografía nos permite ver la estructura que genera el problema y, cuando está indicado, intervenir sobre ella con precisión.</p>
          <p>Pero ningún tratamiento invasivo funciona solo. Cada plan empieza con una evaluación completa y continúa con un plan de readaptación para que vuelvas a tu actividad con un tejido capaz de tolerar la carga. Si un tratamiento invasivo no es la mejor opción para tu caso, te lo vamos a decir.</p>
          {known(p.experience) && <p>{p.experience}</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="on-dark noise relative overflow-hidden bg-navy-950 py-20 text-white md:py-28" aria-labelledby="pasos">
    <div class="bg-grid bg-grid-fade absolute inset-0" aria-hidden="true"></div>
    <div class="glow -top-40 right-0 size-[560px] opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1240px] px-5 sm:px-8">
      <SectionHead id="pasos" eyebrow="Metodología" title='Cuatro pasos, <span class="text-gradient">un mismo criterio</span>' lead="Primero se evalúa. Después se decide." />
      <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {steps.map(([ic, t, d], i) => (
          <li class="border-gradient spotlight relative rounded-3xl p-6" data-reveal data-spotlight>
            <span class="grid size-12 place-items-center rounded-2xl bg-white/10 text-ice-300"><Icon name={ic} /></span>
            <p class="mt-5 font-display text-[0.72rem] font-semibold tracking-[0.12em] text-ice-300/70 uppercase">Paso {i + 1}</p>
            <h3 class="mt-1 text-[1.15rem] font-semibold text-white">{t}</h3>
            <p class="mt-2 text-[0.94rem] text-white/75">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-zinc-50 py-14 md:py-28" aria-labelledby="formacion">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
      <SectionHead id="formacion" eyebrow="Certificaciones" title="Formación certificada" />
      <div class="rounded-[2rem] border border-zinc-200 bg-white p-6 md:p-10" data-reveal>
        <h3 class="mb-6 text-[1.2rem] font-semibold text-ink">Sellos de certificación</h3>
        <CertStrip />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-28" aria-labelledby="areas">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div>
        <SectionHead id="areas" eyebrow="Áreas de trabajo" title="En qué nos especializamos" />
        <ul class="-mt-4 grid gap-2">
          {areas.map(([href, label]) => (
            <li data-reveal><a href={href} class="group flex items-center justify-between rounded-2xl border border-zinc-200 px-5 py-4 font-semibold text-ink-soft no-underline transition hover:border-navy-700/30 hover:bg-navy-50">{label}<Icon name="arrow" size={18} class="text-navy-500 transition group-hover:translate-x-1" /></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
