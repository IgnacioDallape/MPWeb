---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { config, known, waLink, hasWhatsapp } from '../lib/site.js';
import * as S from '../lib/schema.js';

const path = '/contacto/';
const b = config.business;
const c = config.contact;
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Contacto', path }];
const mapsHref = known(b.mapsUrl) || (b.geo ? `https://www.google.com/maps/search/?api=1&query=${b.geo.lat},${b.geo.lng}` : '');
const waNumber = (c.whatsapp || '').replace(/\D/g, '');
const ig = known(c.instagram);
const zonas = ['Hombro', 'Codo / antebrazo', 'Cadera / glúteo', 'Rodilla', 'Tobillo / tendón de Aquiles', 'Pie / talón', 'Músculo (desgarro, contractura)', 'Columna / cuello', 'Otra'];
const schema = [S.breadcrumbs(crumbs), S.webPage({ path, type: 'ContactPage', title: 'Contacto', description: 'Datos de contacto y turnos.', updated: config.launchDate, extra: { about: { '@id': S.ids.ORG_ID() } } })];
---
<Base
  title="Contacto y turnos | Fisioterapia Invasiva en {{CIUDAD}}"
  description="Dirección, horarios y WhatsApp para solicitar una evaluación de fisioterapia invasiva ecoguiada con {{NOMBRE}} en {{LOCALIDAD}}, {{PROVINCIA}}."
  schema={schema}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Contacto y turnos"
    render="probe"
    renderAlt="Ilustración 3D de una sonda ecográfica"
    h1="Solicitar evaluación de fisioterapia invasiva en {{CIUDAD}}"
    lead="Escribinos por WhatsApp contando brevemente qué te pasa. Coordinamos una primera consulta de evaluación clínica y ecográfica."
  />

  <section class="bg-zinc-50 py-16 md:py-24">
    <div class="mx-auto grid max-w-[1240px] gap-8 px-5 sm:px-8 lg:grid-cols-2 lg:gap-12">
      <div data-reveal>
        <h2 class="mb-6 text-[1.8rem] font-semibold text-navy-950">Datos de contacto</h2>
        <ul class="grid gap-3">
          {[
            ['pin', 'Dirección', `${b.address}, ${b.city}, ${b.province} ${b.postalCode}`, null],
            ['whatsapp', 'WhatsApp / Teléfono', c.phoneDisplay, hasWhatsapp() ? waLink() : null],
            ['clock', 'Horarios', config.hoursText, null],
            ['instagram', 'Instagram', ig ? ig.replace(/^https?:\/\/(www\.)?instagram\.com\//, '@').replace(/\/$/, '') : c.instagram, ig || null],
            ...(known(c.email) ? [['book', 'Email', c.email, `mailto:${c.email}`]] : []),
          ].map(([ic, label, value, href]) => (
            <li class="flex gap-4 rounded-2xl border border-zinc-200 bg-white p-4">
              <span class="grid size-11 flex-none place-items-center rounded-xl bg-navy-950 text-ice-300"><Icon name={ic as string} size={20} /></span>
              <span><strong class="block text-[0.75rem] font-semibold tracking-[0.14em] text-zinc-400 uppercase">{label}</strong>{href ? <a href={href as string} class="font-semibold text-navy-800" rel="noopener" target={(href as string).startsWith('http') ? '_blank' : undefined}>{value}</a> : <span class="font-semibold text-navy-950">{value}</span>}</span>
            </li>
          ))}
        </ul>
        <div class="on-dark relative mt-6 grid aspect-[16/10] place-items-center overflow-hidden rounded-3xl bg-navy-950 p-6 text-center text-white/70">
          <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
          {mapsHref ? (
            <div class="relative"><Icon name="pin" size={36} class="mx-auto text-ice-300" /><p class="my-3">{b.address}, {b.city}</p><a href={mapsHref} rel="noopener" target="_blank" class="btn btn-glow btn-sm">Cómo llegar en Google Maps</a></div>
          ) : (
            <p class="relative">[PENDIENTE: enlace de Google Maps / Google Business Profile]</p>
          )}
        </div>
      </div>

      <div id="turno" data-reveal>
        <h2 class="mb-2 text-[1.8rem] font-semibold text-navy-950">Solicitar turno</h2>
        <p class="mb-6 text-zinc-500">Completá estos datos y se abrirá WhatsApp con el mensaje listo para enviar. No se almacena ninguna información en este sitio.</p>
        <form id="wa-form" data-wa={waNumber} action={hasWhatsapp() ? `https://wa.me/${waNumber}` : '#'} method="get" target="_blank" class="glass-light grid gap-4 rounded-3xl p-6 md:p-8">
          <label class="field">Nombre<input name="nombre" autocomplete="given-name" required /></label>
          <label class="field">¿Qué zona te molesta?
            <select name="zona"><option value="">Elegí una opción</option>{zonas.map((z) => <option>{z}</option>)}</select>
          </label>
          <label class="field">Contanos brevemente qué te pasa <small class="font-normal text-zinc-500">(desde cuándo, qué actividad hacés)</small><textarea name="detalle" rows="4"></textarea></label>
          <label class="field">Preferencia horaria<select name="horario"><option value="">Sin preferencia</option><option>Mañana</option><option>Tarde</option></select></label>
          <input type="hidden" name="text" value="" />
          <button class="btn btn-primary btn-shine mt-2" type="submit"><Icon name="whatsapp" size={20} />Enviar por WhatsApp</button>
          <small class="text-zinc-500">Al enviar, se abre WhatsApp en tu dispositivo. Revisá el mensaje antes de mandarlo.</small>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24" aria-labelledby="primera-consulta">
    <div class="mx-auto grid max-w-[1240px] gap-12 px-5 sm:px-8 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow mb-4">Primera consulta</p>
        <h2 id="primera-consulta" class="text-[clamp(1.6rem,3vw,2.3rem)] font-semibold text-navy-950">Qué incluye la evaluación</h2>
        <ul class="mt-6 grid gap-3">
          {['Entrevista sobre tu lesión, actividad y objetivos.', 'Exploración física: movilidad, fuerza y tolerancia a la carga.', 'Ecografía musculoesquelética de la zona.', 'Explicación de lo encontrado y propuesta de plan.'].map((t) => (
            <li class="flex gap-3"><span class="mt-1 grid size-6 flex-none place-items-center rounded-full bg-navy-700 text-white"><Icon name="check" size={14} /></span>{t}</li>
          ))}
        </ul>
        <p class="mt-6 text-zinc-600">Si tenés estudios previos, traelos. Más detalles en <a href="/blog/primera-sesion-fisioterapia-invasiva/" class="font-semibold text-navy-600">qué esperar en la primera sesión</a>.</p>
      </div>
      <div data-reveal>
        <h2 class="text-[clamp(1.6rem,3vw,2.3rem)] font-semibold text-navy-950">Áreas de atención</h2>
        <p class="mt-4 text-zinc-600">Consultorio en {b.city}, con atención a pacientes de todo Mendoza: {b.areaServed.filter((a) => a !== b.city).join(', ')} y el resto de la provincia.</p>
        <p class="text-zinc-600">[PENDIENTE: obras sociales / prepagas y formas de pago]</p>
      </div>
    </div>
  </section>

  <script>
    const f = document.getElementById('wa-form');
    f?.addEventListener('submit', (e) => {
      const n = f.dataset.wa;
      const d = new FormData(f);
      const t = ['Hola, quería solicitar una evaluación.', d.get('nombre') && `Nombre: ${d.get('nombre')}`, d.get('zona') && `Zona: ${d.get('zona')}`, d.get('detalle') && `Detalle: ${d.get('detalle')}`, d.get('horario') && `Preferencia horaria: ${d.get('horario')}`].filter(Boolean).join('\n');
      e.preventDefault();
      if (!n) return alert('El número de WhatsApp todavía no está configurado.');
      window.open(`https://wa.me/${n}?text=${encodeURIComponent(t)}`, '_blank', 'noopener');
    });
  </script>
</Base>
