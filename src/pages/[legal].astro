---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { LEGAL } from '../data/legal.js';
import { markdown } from '../lib/md.js';
import { config, formatDate } from '../lib/site.js';
import * as S from '../lib/schema.js';
export function getStaticPaths() {
  return LEGAL.map((page) => ({ params: { legal: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const crumbs = [{ name: 'Inicio', path: '/' }, { name: page.h1, path: `/${page.slug}/` }];
---
<Base title={page.title} description={page.description} noindex schema={[S.breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} h1={page.h1} />
  <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <div class="prose-site" set:html={markdown(page.body).html} />
    <p class="mt-10 text-sm text-zinc-500">Última actualización: {formatDate(config.launchDate)}.</p>
  </div>
</Base>
