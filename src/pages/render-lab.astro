---
// Estudio de renders (solo herramienta interna). Se elimina del build en scripts/postbuild.js.
---
<html lang="es"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>render-lab</title>
<style>html,body{margin:0;background:transparent}canvas{display:block;width:1200px;height:900px}</style></head>
<body><canvas id="c" width="1200" height="900"></canvas>
<script>
  import * as THREE from 'three';
  import { studio, SCENES, LIB } from '../scripts/lab3d.js';
  const MODELS = import.meta.glob('../scripts/models/*.js');
  const name = new URLSearchParams(location.search).get('scene') || 'epi';
  const canvas = document.getElementById('c');
  const { renderer, scene, camera } = studio(canvas);
  renderer.setPixelRatio(1);
  renderer.setSize(1200, 900, false);
  camera.aspect = 1200 / 900;
  camera.updateProjectionMatrix();
  const key = `../scripts/models/${name}.js`;
  const def = MODELS[key] ? (await MODELS[key]()).default(LIB) : SCENES[name]();
  scene.add(def.root);
  if (def.shadow !== false) {
    const box = new THREE.Box3().setFromObject(def.root);
    const sh = (await import('../scripts/lab3d.js')).halo('#0a1530', 1, 0.2);
    sh.scale.set((box.max.x - box.min.x) * 0.9, (box.max.x - box.min.x) * 0.12, 1);
    sh.position.set((box.max.x + box.min.x) / 2, box.min.y - 0.15, 0);
    scene.add(sh);
  }
  // Alejar la cámara para que el objeto entre completo (luego se recorta el borde transparente)
  const look = new THREE.Vector3(...def.look);
  camera.position.copy(look.clone().add(new THREE.Vector3(...def.cam).sub(look).multiplyScalar(def.zoom ?? 1.5)));
  camera.lookAt(...def.look);
  renderer.render(scene, camera);
  requestAnimationFrame(() => { renderer.render(scene, camera); window.__done = true; });
</script>
</body></html>
